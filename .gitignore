mise.local.toml
/raw/

# Downloaded soundboard clips (third-party audio); the mapping lives in sfx.toml
# and `mise run sfx:fetch` re-downloads them.
/sfx/*
!/sfx/.gitkeep

# Bot OAuth tokens (secret/state written by `mise run bot:auth`).
/bot.tokens.json

# Refreshed Connections corpus (`mise run connections:sync`); the bot embeds a
# seed copy, so this runtime override is optional and not committed.
/connections.json
/connections.json.part

# Bot SQLite database (custom commands, points) + WAL sidecars.
/bot.db
/bot.db-shm
/bot.db-wal

debug/
raw/
